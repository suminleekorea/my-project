{
  "display_information": {
    "name": "Daily Briefing",
    "description": "7 AM morning briefing — emails, calendar, partnerships, deadlines, ideas",
    "background_color": "#1a1a2e"
  },
  "features": {
    "bot_user": {
      "display_name": "Daily Briefing",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "im:write",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
