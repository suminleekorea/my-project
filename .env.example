# ─── Slack ────────────────────────────────────────────────────────────────────
# Bot token from https://api.slack.com/apps  (needs chat:write scope)
SLACK_BOT_TOKEN=xoxb-

# Where to send the briefing. Accepts any of:
#   - Your email (recommended): resolves to your DM in the bot's workspace
#     regardless of which workspace it is — e.g. you@gmail.com
#   - A Slack User ID (U...): DMs that user
#   - A channel ID (C.../G...): posts to that channel (invite the bot first)
# Email is the most robust because Slack member IDs differ per workspace.
SLACK_CHANNEL_ID=leewaterfolk@gmail.com

# ─── Google OAuth2 ────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create a project → enable Gmail API + Google Calendar API
# 3. Create OAuth2 credentials (Web application)
# 4. Add authorised redirect URI: https://YOUR_APP.vercel.app/api/auth/google/callback
# 5. Visit https://YOUR_APP.vercel.app/setup and click "Connect Google"
# 6. Copy the refresh_token shown after authorisation
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-

# ─── Security ─────────────────────────────────────────────────────────────────
# Random string used to authenticate the cron endpoint
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ─── App ──────────────────────────────────────────────────────────────────────
# Your Vercel deployment URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Timezone for "today" / "yesterday" resolution (IANA format)
TIMEZONE=Asia/Singapore
